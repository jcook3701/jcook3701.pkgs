{%- macro wireguard_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

[Interface]
# Local node private cryptographic key string
PrivateKey = {{ wireguard_private_key }}

# Internal tunnel interface IP assignment and routing block
Address = {{ wireguard_address }}

{% if wireguard_port is defined and wireguard_port is not none %}
# UDP port listening for incoming direct encapsulations
ListenPort = {{ wireguard_port }}
{% endif %}

{% if wireguard_post_up | length > 0 %}
# Firewall rules and scripts executed right after tunnel boot-up sequences
{% for cmd in wireguard_post_up %}
PostUp = {{ cmd }}
{% endfor %}
{% endif %}

{% if wireguard_post_down | length > 0 %}
# Firewall rules and scripts executed right after tunnel shutdown sequences
{% for cmd in wireguard_post_down %}
PostDown = {{ cmd }}
{% endfor %}
{% endif %}

{% if wireguard_peers | length > 0 %}
# Connected Peer Configurations
# =============================
{% for peer in wireguard_peers %}
[Peer]
# Name Reference: {{ peer.name | default('Unnamed Peer') }}
PublicKey = {{ peer.public_key }}

{% if peer.preshared_key is defined and peer.preshared_key is not none %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}

# Direct routed network subnets assigned to this node link
AllowedIPs = {{ peer.allowed_ips | join(', ') }}

{% if peer.endpoint is defined and peer.endpoint is not none %}
# Public-facing IPv4/IPv6 target or FQDN connection string
Endpoint = {{ peer.endpoint }}
{% endif %}

{% if peer.persistent_keepalive is defined and peer.persistent_keepalive is not none %}
# Active keepalive timer interval string to sustain stateful NAT paths
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
{% endif %}
{%- endmacro -%}

{{- wireguard_conf() -}}
