<?xml version="1.0" encoding="utf-8"?>
<LdapAuthenticationConfiguration xmlns:xsi="http://w3.org" xmlns:xsd="http://w3.org">
  <Server>{{ jellyfin_ldap_server }}</Server>
  <InsecurePort>{{ jellyfin_ldap_port_insecure | default(389) }}</InsecurePort>
  <SecurePort>{{ jellyfin_ldap_port_secure | default(636) }}</SecurePort>
  <UseSsl>{{ jellyfin_ldap_use_ssl | type_debug == 'bool' | ternary(jellyfin_ldap_use_ssl, false) | lower }}</UseSsl>
  <SkipSslVerification>{{ jellyfin_ldap_skip_ssl_verify | type_debug == 'bool' | ternary(jellyfin_ldap_skip_ssl_verify, false) | lower }}</SkipSslVerification>
  <BaseDn>{{ jellyfin_ldap_base_dn }}</BaseDn>
  <SearchFilter>{{ jellyfin_ldap_search_filter }}</SearchFilter>
  <SearchAttributes>
    <string>uid</string>
    <string>cn</string>
  </SearchAttributes>
  <UsernameAttribute>{{ jellyfin_ldap_username_attribute | default('uid') }}</UsernameAttribute>
  <AdminFilter>{{ jellyfin_ldap_admin_filter | default('') }}</AdminFilter>
  <IsEnabled>true</IsEnabled>
</LdapAuthenticationConfiguration>
