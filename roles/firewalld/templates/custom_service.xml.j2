{% macro custom_service() -%}
<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by Ansible - Manual changes will be overwritten -->
<service>
  <short>{{ firewalld_service_name }}</short>
  <description>{{ firewalld_service_description }}</description>
{% for port_entry in firewalld_service_ports %}
  <port protocol="{{ port_entry.protocol | default('tcp') }}" port="{{ port_entry.port }}"/>
{% endfor %}
</service>
{%- endmacro %}

{{- custom_service() -}}
