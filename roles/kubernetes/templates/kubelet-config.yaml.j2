---
apiVersion: {{ kubernetes_kubelet_api_version }}
kind: KubeletConfiguration

# -------------------------------------------------------------------------
# Container Runtime Configuration
# -------------------------------------------------------------------------
cgroupDriver: {{ kubernetes_kubelet_cgroup_driver | to_json }}

{% if kubernetes_cri_socket %}
containerRuntimeEndpoint: {{ kubernetes_cri_socket | to_json }}
{% endif %}

# -------------------------------------------------------------------------
# Security & Certificate Configuration
# -------------------------------------------------------------------------
rotateCertificates: {{ kubernetes_kubelet_rotate_certificates | bool | lower }}

# -------------------------------------------------------------------------
# Kubernetes Networking Configuration
# -------------------------------------------------------------------------
{% if kubernetes_kubelet_cluster_dns %}
clusterDNS:
{% for server in kubernetes_kubelet_cluster_dns %}
  - {{ server | to_json }}
{% endfor %}
{% endif %}

{% if kubernetes_kubelet_resolv_conf %}
resolvConf: {{ kubernetes_kubelet_resolv_conf | to_json }}
{% endif %}
