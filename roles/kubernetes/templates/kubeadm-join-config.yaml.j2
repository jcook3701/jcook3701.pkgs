---
apiVersion: {{ kubernetes_kubeadm_api_version }}
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ kubernetes_join_api_server_endpoint | to_json }}
    token: {{ kubernetes_join_token | to_json }}
    caCertHashes:
{% for hash in kubernetes_join_ca_cert_hashes %}
      - {{ hash | to_json }}
{% endfor %}
{% if kubernetes_node_name or kubernetes_cri_socket %}
nodeRegistration:
{% if kubernetes_node_name %}
  name: {{ kubernetes_node_name | to_json }}
{% endif %}
{% if kubernetes_cri_socket %}
  criSocket: {{ kubernetes_cri_socket | to_json }}
{% endif %}
{% endif %}
{% if kubernetes_join_control_plane %}
controlPlane:
  localAPIEndpoint:
{% if kubernetes_join_advertise_address %}
    advertiseAddress: {{ kubernetes_join_advertise_address | to_json }}
{% endif %}
    bindPort: {{ kubernetes_api_bind_port }}
{% if kubernetes_join_certificate_key %}
  certificateKey: {{ kubernetes_join_certificate_key | to_json }}
{% endif %}
{% endif %}
