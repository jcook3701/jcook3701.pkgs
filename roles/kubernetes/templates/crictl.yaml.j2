# -------------------------------------------------------------------------
# Kubernetes CRI Runtime Configuration
# -------------------------------------------------------------------------
runtime-endpoint: {{ kubernetes_crictl_runtime_endpoint_effective | to_json }}

image-endpoint: {{ (kubernetes_crictl_image_endpoint if kubernetes_crictl_image_endpoint | length > 0 else kubernetes_crictl_runtime_endpoint_effective) | to_json }}

# -------------------------------------------------------------------------
# Kubernetes CRI Connection Configuration
# -------------------------------------------------------------------------
timeout: {{ kubernetes_crictl_timeout }}

# -------------------------------------------------------------------------
# Kubernetes CRI Debug Configuration
# -------------------------------------------------------------------------
debug: {{ kubernetes_crictl_debug | bool | lower }}
