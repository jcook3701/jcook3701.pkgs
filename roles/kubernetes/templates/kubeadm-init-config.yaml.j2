---
apiVersion: {{ kubernetes_kubeadm_api_version }}
kind: InitConfiguration
{% if kubernetes_node_name or kubernetes_cri_socket %}
nodeRegistration:
{% if kubernetes_node_name %}
  name: {{ kubernetes_node_name | to_json }}
{% endif %}
{% if kubernetes_cri_socket %}
  criSocket: {{ kubernetes_cri_socket | to_json }}
{% endif %}
{% endif %}
localAPIEndpoint:
{% if kubernetes_api_advertise_address %}
  advertiseAddress: {{ kubernetes_api_advertise_address | to_json }}
{% endif %}
  bindPort: {{ kubernetes_api_bind_port }}
---
apiVersion: {{ kubernetes_kubeadm_api_version }}
kind: ClusterConfiguration
clusterName: {{ kubernetes_cluster_name | to_json }}
kubernetesVersion: {{ ('v' ~ kubernetes_kubernetes_version) | to_json }}
{% if kubernetes_control_plane_endpoint %}
controlPlaneEndpoint: {{ kubernetes_control_plane_endpoint | to_json }}
{% endif %}
networking:
  dnsDomain: {{ kubernetes_dns_domain | to_json }}
  serviceSubnet: {{ kubernetes_service_subnet | to_json }}
{% if kubernetes_pod_subnet %}
  podSubnet: {{ kubernetes_pod_subnet | to_json }}
{% endif %}
