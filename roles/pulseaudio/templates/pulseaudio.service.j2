{%- macro service() -%}
[Unit]
Description=PulseAudio System-Wide Sound Server
After=sound.target

[Service]
Type=forking
PIDFile={{ pulseaudio_file.pid }}
ExecStart=/usr/bin/pulseaudio --system --daemonize --log-target=syslog
Restart=always

[Install]
WantedBy=multi-user.target
{%- endmacro -%}

{{- service() }}
