{%- macro default_pa() -%}
# ==================== CORE HARDWARE ENGINE ====================
# Always load core communication pipes and hardware card detectors natively
load-module module-native-protocol-unix
load-module module-udev-detect
load-module module-default-device-restore
load-module module-always-sink
load-module module-position-event-sounds
load-module module-switch-on-connect

{% if pulseaudio_is_server and pulseaudio_enable_network %}
# ==================== SERVER NETWORK ROUTING ====================
# Listen securely on the network for client audio input streams
load-module module-native-protocol-tcp port={{ pulseaudio_port }} auth-anonymous={{ pulseaudio_auth_anonymous }}
{% elif not pulseaudio_is_server and pulseaudio_server_ip != "" %}
# ==================== CLIENT NETWORK ROUTING ====================
# Tunnel all local sound card outputs over the network to the central server
load-module module-tunnel-sink-new server={{ pulseaudio_server_ip }}:{{ pulseaudio_port }}
{% endif %}
{%- endmacro -%}

{{- default_pa() }}
