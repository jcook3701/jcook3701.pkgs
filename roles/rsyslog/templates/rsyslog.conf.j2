{%- macro rsyslog_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

# /etc/rsyslog.conf configuration file for rsyslog
#
# For more information install rsyslog-doc and see
# /usr/share/doc/rsyslog-doc/html/configuration/index.html
#
# Default logging rules can be found in /etc/rsyslog.d/50-default.conf

#################
#### MODULES ####
#################

module(load="imuxsock" SysSock.Use="off") # Turn off legacy socket
input(type="imuxsock" Socket="/run/systemd/journal/syslog") # Read systemd directly

module(load="imklog")   # provides kernel logging support

{% if rsyslog_node_type == 'master' %}
# provides UDP syslog reception
module(load="imudp")
input(type="imudp" port="{{ rsyslog_server_port | default(514) }}")

# provides TCP syslog reception
module(load="imtcp")
input(type="imtcp" port="{{ rsyslog_server_port | default(514) }}")
{% endif %}

###########################
#### GLOBAL DIRECTIVES ####
###########################

$FileOwner {{ rsyslog_file_owner | default('root') | trim }}
$FileGroup {{ rsyslog_file_group | default('adm') | trim }}
$FileCreateMode {{ rsyslog_file_create_mode | default('0640') | trim }}
$DirCreateMode {{ rsyslog_dir_create_mode | default('0755') | trim }}
$Umask {{ rsyslog_umask | default('0022') | trim  }}
$PrivDropToUser {{ rsyslog_user | default('syslog') | trim  }}
$PrivDropToGroup {{ rsyslog_group | default('syslog') | trim  }}

# Where to place spool and state files
$WorkDirectory {{ rsyslog_directory.state | default('/var/spool/rsyslog') }}

# Include all config files in /etc/rsyslog.d/
$IncludeConfig {{ rsyslog_directory.conf_d | default('/etc/rsyslog.d') }}/*.conf

###############
#### RULES ####
###############

{% if rsyslog_node_type == 'client' %}
# Forward all traffic to the remote aggregation server
$ActionQueueType LinkedList
$ActionQueueFileName fwdRule1
$ActionResumeRetryCount -1
$ActionQueueSaveOnShutdown on

{% for host_entry in rsyslog_remote_server_hosts | default([]) %}
{% if not loop.first %}
$ActionExecOnlyWhenPreviousIsFailed on
{% endif %}
{% if rsyslog_remote_protocol | lower == 'tcp' %}
*.*    @@{{ host_entry }}:{{ rsyslog_remote_server_port | default(514) }}
{% else %}
*.*    @{{ host_entry }}:{{ rsyslog_remote_server_port | default(514) }}
{% endif %}
{% if not loop.first %}
$ActionExecOnlyWhenPreviousIsFailed off
{% endif %}
{% endfor %}
{% endif %}

*.emerg    :omusrmsg:*
{%- endmacro -%}

{{- rsyslog_conf() }}
