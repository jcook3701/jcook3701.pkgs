{%- macro rsyslog_default_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

#  Default rules for rsyslog.
#
#                       For more information see rsyslog.conf(5) and /etc/rsyslog.conf

# =================================================================
# STANDARD LOCAL FACILITY LOG ASSIGNMENTS
# =================================================================
{% for rule_item in rsyslog_facility_rules | default([]) %}
{{ rule_item.rule }}    {{ rule_item.target }}
{% endfor %}

# =================================================================
# STANDARD SYSTEM MAIL ERRORS PACKING
# =================================================================
mail.err    {{ rsyslog_directory.log_root | default('/var/log') }}/mail.err
{%- endmacro -%}

{{- rsyslog_default_conf() }}
