{%- macro console_setup() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

# CONFIGURATION FILE FOR SETUPCON

# Consult the console-setup(5) manual page.

ACTIVE_CONSOLES="{{ setupcon_active_consoles | default('/dev/tty[1-6]') }}"

CHARMAP="{{ setupcon_charmap | default('UTF-8') }}"

CODESET="{{ setupcon_codeset | default('guess') }}"
FONTFACE="{{ setupcon_fontface | default('Terminus') }}"
FONTSIZE="{{ setupcon_fontsize | default('16x32') }}"

VIDEOMODE="{{ setupcon_videomode | default('') }}"

# The following is an example how to use a braille font
# FONT='lat9w-08.psf.gz brl-8x8.psf'
{%- endmacro -%}

{{- console_setup() }}
