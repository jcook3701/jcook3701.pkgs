{%- macro uxplay_toggle(user_home) -%}
#!/bin/bash
# XFCE Genmon Toggle Script for UxPlay

# If the script was clicked, toggle the state
if [ "$1" = "click" ]; then
    if pgrep -x "uxplay" > /dev/null; then
        pkill -x "uxplay"
    else
        # Runs in background, but handles rendering safely
        uxplay -avdec > /dev/null 2>&1 &
    fi
    # Small delay to let the process register before updating the icon
    sleep 0.5
fi

# Update the taskbar display based on whether it is running
if pgrep -x "uxplay" > /dev/null; then
    echo "<txt>🖥️ 🟢</txt><txtclick>{{ user_home }}/.local/bin/uxplay-toggle.sh click</txtclick><tool>UxPlay is RUNNING. Click monitor to stop.</tool>"
else
    echo "<txt>🖥️ 📺</txt><txtclick>{{ user_home }}/.local/bin/uxplay-toggle.sh click</txtclick><tool>UxPlay is IDLE. Click monitor to start.</tool>"
fi
{%- endmacro -%}

{{- uxplay_toggle(sudo_user_home) }}
