{%- macro autofs_ldap_auth_conf() -%}
<?xml version="1.0" encoding="utf-8"?>
<autofs_ldap_sasl_conf
    usetls="{{ autofs_sasl_usetls | default('no') | trim }}"
    tlsrequired="{{ autofs_sasl_tlsrequired | default('no') | trim }}"
    authrequired="{{ autofs_sasl_authrequired | default('yes') | trim }}"
    authmechanism="{{ autofs_sasl_authmechanism | default('GSSAPI') | trim }}"
    credentialcache="{{ autofs_file.sasl_credential_cache | trim }}"
/>
{%- endmacro -%}

{{- autofs_ldap_auth_conf() }}
