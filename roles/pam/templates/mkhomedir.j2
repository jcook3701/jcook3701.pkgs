{%- macro mkhomedir() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.
{% if ansible_os_family == 'Debian' %}
Name: Custom home directory creation and mask reinforcement
Default: yes
Priority: 0
Session-Type: Additional
Session:
	optional	pam_umask.so umask=0077
	required	pam_mkhomedir.so {{ pam_mkhomedir_options | default('skel=/etc/skel umask=0022') | trim }}
{% endif %}
{%- endmacro -%}
{{- mkhomedir() }}
