{#
  Macro: kdc_realm_properties
  Purpose: Compiles the backend database parameters, security rules, and real-time
           incremental database replication settings for the local directory partition.
#}
{%- macro kdc_realm_properties() -%}
# Core Database Engine Paths
database_name = {{ kerberos_file.principal }}
admin_keytab = {{ kerberos_keytabs.kdc_admin }}
acl_file = {{ kerberos_file.admin_acl }}
dict_file = {{ kerberos_file.dictionary }}
{% if kerberos_use_stash_file | bool %}
key_stash_file = {{ kerberos_file.stash }}
{% endif %}

# Ticket Lifetime Restrictions
max_life = 10h 0m 0s
max_renewable_life = 7d 0h 0m 0s

# Server-Side Master Cryptographic Key Configurations
master_key_type = {{ kerberos_encryption_types | first }}
supported_enctypes = {% for enc in kerberos_encryption_types %}{{ enc }}:normal {% endfor %}

# Administrative Service Daemon Bind Port
kadmind_port = {{ kerberos_admin_port }}

# Incremental Replication (Iprop) Live Sync Logging Mechanics
iprop_enable = {{ kerberos_iprop_enable }}
iprop_port = {{ kerberos_iprop_port }}
{% if kerberos_node_type == 'master' %}
iprop_logfile = {{ kerberos_file.unlimited_ulog }}
{% elif kerberos_node_type == 'replica' %}
iprop_replica_poll = {{ kerberos_iprop_replica_poll }}
iprop_replica_ulog_spec = file:{{ kerberos_file.replica_ulog }}:1000
iprop_master_ulog_spec = file:{{ kerberos_file.principal_ulog }}
{% endif %}
{%- endmacro -%}


{#
  Macro: kdc_global_config
  Purpose: Builds the root structural layout blocks for the MIT KDC engine, including
           global port configurations and nested realm database blocks.
#}
{%- macro kdc_global_config() -%}
[kdcdefaults]
    kdc_ports = {{ kerberos_port }}
    kdc_tcp_ports = {{ kerberos_port }}

[realms]
    {{ kerberos_realm }} = {
        {{ kdc_realm_properties() | indent(8) }}
    }

[logging]
    kdc = FILE:{{ kerberos_file.kdc_log }}
    admin_server = FILE:{{ kerberos_file.admin_log }}
{%- endmacro -%}

{{- kdc_global_config() -}}
