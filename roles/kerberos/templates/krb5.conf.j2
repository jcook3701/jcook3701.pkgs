{%- macro krb5() -%}
[libdefaults]
    default_realm = {{ kerberos_default_realm | upper }}
    dns_lookup_realm = {{ kerberos_dns_lookup_realm }}
    dns_lookup_kdc = {{ kerberos_dns_lookup_kdc }}
    ticket_lifetime = {{ kerberos_ticket_lifetime }}
    renew_lifetime = {{ kerberos_renew_lifetime }}
    forwardable = {{ kerberos_forwardable }}
    rdns = false

[realms]
    {{ kerberos_default_realm | upper }} = {
    {% for realm in kerberos_realms %}
        kdc = {{ realm.kdc }}
    {% endfor %}
        admin_server = {{ (kerberos_realms | first).admin_server | default('kerberos.' ~ kerberos_domain_name) }}
    }

[domain_realm]
{% for item in kerberos_domain_realms %}
    {{ item.domain }} = {{ item.realm | upper }}
{% endfor %}

[logging]
    default = FILE:{{ kerberos_file.default_log }}
    kdc = FILE:{{ kerberos_file.kdc_log }}
    admin_server = FILE:{{ kerberos_file.admin_log }}
{%- endmacro -%}

{{- krb5() -}}
