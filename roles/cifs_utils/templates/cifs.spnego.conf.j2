{%- macro cifs_spnego_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

{% if cifs_utils_use_gssproxy | bool %}
create cifs.spnego * * /usr/bin/env GSS_USE_PROXY=yes GSSPROXY_SOCKET={{ cifs_utils_socket.gssproxy_socket }} {{ cifs_utils_command.upcall }} {{ cifs_utils_request_key_command_flags | trim }} %k
{% else %}
create cifs.spnego * * {{ cifs_utils_command.upcall }} {{ cifs_utils_request_key_command_flags | trim }} %k
{% endif %}
{%- endmacro -%}

{{- cifs_spnego_conf() }}
