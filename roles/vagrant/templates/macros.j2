{% macro header(filename) -%}
###############################################################################
# File: {{ filename }}
# Generated by Ansible (Role: vagrant)
# Timestamp: {{ ansible_date_time.iso8601 }}
# DO NOT EDIT MANUALLY - Your changes will be overwritten.
###############################################################################
{%- endmacro %}


{% macro vagrantfile() %}
{{ header('Vagrantfile') }}
Vagrant.configure("2") do |config|
  config.vm.box = "{{ vagrant_box }}"
  config.vm.box_version = "{{ vagrant_box_version | default('>= 0') }}"
  # Force VirtualBox to avoid that libvirt error

  config.vm.provider "virtualbox" do |vb|
    vb.name = "{{ vagrant_vm_name }}"
    vb.memory = {{ vagrant_memory_mb }}
    vb.cpus = {{ vagrant_cpus }}
    vb.gui = {{ vagrant_gui_enabled | lower }}
  end

  {# Direct Bridge Networking (Public Network) #}
  {% if vagrant_network_type == 'public_network' %}
  config.vm.network "public_network", ip: "{{ vagrant_ip }}", netmask: "{{ vagrant_netmask | default('255.255.255.0') }}", bridge: "{{ vagrant_bridge }}"
  {% endif %}

  {# Port Forwarding (Only if explicitly defined) #}
  {% if vagrant_forwarded_ports is defined %}
  {% for port in vagrant_forwarded_ports %}
  config.vm.network "forwarded_port", guest: {{ port.guest }}, host: {{ port.host }}
  {% endfor %}
  {% endif %}

  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "provision.yml"
    ansible.become = true
    ansible.playbook_command = "{{ vagrant_ansible_path }}"
  end
end
{% endmacro %}
