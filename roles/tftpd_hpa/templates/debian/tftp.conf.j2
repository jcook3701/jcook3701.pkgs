{%- macro tftp_conf_debian() -%}
TFTP_USERNAME="tftp"
TFTP_DIRECTORY="{{ tftpd_hpa_directory.root }}"
TFTP_ADDRESS=":{{ tftpd_hpa_port | default('69') }}"
TFTP_OPTIONS="{{ tftpd_hpa_options | default('--secure --create') }}"
{%- endmacro -%}

{{- tftp_conf_debian() }}
