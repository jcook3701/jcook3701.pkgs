{%- macro sshd_config() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

# Central Connection Configurations
Port {{ ssh_port }}
ListenAddress {{ ssh_listen_address }}
Protocol {{ ssh_protocol_version }}

# Host Security Keys Configurations
HostKey {{ ssh_directory.conf }}/ssh_host_rsa_key
HostKey {{ ssh_directory.conf }}/ssh_host_ecdsa_key
HostKey {{ ssh_directory.conf }}/ssh_host_ed25519_key

# System Runtime Boundary Hardening
PidFile {{ ssh_file.pid }}

# Operational Logging Profiles
SyslogFacility AUTH
LogLevel INFO

# Operational Connection Constraints
LoginGraceTime {{ ssh_login_grace_time }}
PermitRootLogin {{ ssh_permit_root_login }}
StrictModes {{ ssh_strict_modes }}
MaxAuthTries {{ ssh_max_auth_tries }}
MaxSessions 10

# Primary Cryptographic Matrix Compliance Constraints
Ciphers {{ ssh_ciphers | join(',') }}
Macs {{ ssh_macs | join(',') }}
KexAlgorithms {{ ssh_kex_algorithms | join(',') }}

# Centralized Authentication Mechanisms Routing
PubkeyAuthentication {{ ssh_pubkey_authentication }}
AuthorizedKeysFile {{ ssh_authorized_keys_file }}

PasswordAuthentication {{ ssh_password_authentication }}
KbdInteractiveAuthentication {{ ssh_kbd_interactive_authentication }}

# Intercept and Bind into System PAM Stack Loops
UsePAM {{ ssh_use_pam }}

# Network Subsystem Restrictions
X11Forwarding {{ ssh_x11_forwarding }}
PrintMotd no
PrintLastLog yes
TCPKeepAlive yes
AcceptEnv LANG LC_*

# Built-In SFTP System Provisioner Hook
Subsystem sftp {{ ssh_file.sftp_server }}
{%- endmacro -%}

{{- sshd_config() }}
