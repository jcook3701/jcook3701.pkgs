{%- macro service_snippet() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Dedicated proxy snippet profile for: {{ service.name }}
# Manual edits will be overwritten.

[{{ service.section }}]
  mechs = {{ service.mechs | default('krb5') }}
  socket = {{ service.socket }}
  cred_usage = {{ service.cred_usage }}
  euid = {{ service.euid }}
{% if service.program is defined and service.program | length > 0 %}
  program = {{ service.program }}
{% endif %}
{% if service.set_gss_proxy is defined and service.set_gss_proxy | bool %}
  set_gss_proxy = yes
{% endif %}
{% if service.kernel_nfsd is defined and service.kernel_nfsd | bool %}
  kernel_nfsd = yes
{% endif %}
{% if service.cred_store is defined and service.cred_store | length > 0 %}
{% for store in service.cred_store %}
  cred_store = {{ store }}
{% endfor %}
{% endif %}
  allow_any_uid = {{ service.allow_any_uid | default(false) | lower }}
  trusted = {{ service.trusted | default(false) | lower }}
{% if service.impersonate is defined %}
  impersonate = {{ service.impersonate | default(false) | lower }}
{% endif %}
{%- endmacro -%}

{{- service_snippet() }}
