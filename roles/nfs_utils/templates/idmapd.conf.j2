{%- macro idmap_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

[General]
# NFSv4 Identity Mapping Domain
Domain = {{ nfs_utils_domain_name | trim }}

# Verbosity level for logging to syslog (0 is default)
Verbosity = 0

[Mapping]
# Target fallback IDs for unmapped remote users and groups
Nobody-User = {{ nfs_utils_user | default('nobody') | trim }}
Nobody-Group = {{ nfs_utils_group | default('nobody') | trim }}

[Translation]
# Specifies the identity translation method used by the daemon
Method = nsswitch
{%- endmacro -%}

{{- idmap_conf() }}
