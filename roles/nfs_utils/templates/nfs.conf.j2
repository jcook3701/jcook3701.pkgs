{%- macro nfs_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

[general]
# Core system-wide NFS operational parameters

[nfsd]
# Server-side daemon configuration
threads = {{ nfs_utils_server_threads | trim }}
{% for version, toggle in nfs_utils_server_protocols.items() %}
{{ version | replace('_', '.') | replace('v', 'vers') }} = {{ toggle }}
{% endfor %}

[gssd]
# GSS-API Credential Security Daemon configuration
{% if nfs_utils_use_gssproxy | bool and nfs_utils_node_type != 'master' %}
use-gss-proxy = 1
{% else %}
use-gss-proxy = 0
{% endif %}

[svcgssd]
# Server-side GSS Verification Daemon configuration
{% if nfs_utils_use_svcgssd | bool %}
principal = {{ nfs_utils_krb5_principal | trim }}
{% endif %}

[mountd]
# NFS Mount Daemon settings
options = {{ nfs_utils_mountd_options | trim }}

[statd]
# NSM status monitoring controls
{%- endmacro -%}

{{- nfs_conf() }}
