{%- macro cloudflared_conf() -%}
# Auto-generated by Ansible for {{ inventory_hostname }}
# Manual edits will be overwritten.
---
# -------------------------------------------------------------------------
# Cloudflared Tunnel Identification & Authentication
# -------------------------------------------------------------------------
tunnel: {{ cloudflared_tunnel_uuid | to_json }}
credentials-file: {{ cloudflared_file.credentials | to_json }}

# -------------------------------------------------------------------------
# Cloudflared Tunnel Runtime Configuration
# -------------------------------------------------------------------------
protocol: {{ cloudflared_protocol | to_json }}
loglevel: {{ cloudflared_loglevel | to_json }}
grace-period: {{ cloudflared_grace_period | to_json }}

{% if cloudflared_logfile | length > 0 %}
logfile: {{ cloudflared_logfile | to_json }}
{% endif %}
{% if cloudflared_metrics | length > 0 %}
metrics: {{ cloudflared_metrics | to_json }}
{% endif %}
{% if cloudflared_region | length > 0 %}
region: {{ cloudflared_region | to_json }}
{% endif %}

# -------------------------------------------------------------------------
# Cloudflared Origin Server Configuration
# -------------------------------------------------------------------------
{% if cloudflared_origin_request %}
originRequest:
{{ cloudflared_origin_request | to_nice_yaml(indent=2, sort_keys=False) | indent(2, true) }}
{% endif %}

# -------------------------------------------------------------------------
# Cloudflared Ingress Routing Configuration
# -------------------------------------------------------------------------
ingress:
{{ cloudflared_ingress | to_nice_yaml(indent=2, sort_keys=False) | indent(2, true) }}
{%- endmacro -%}

{{- cloudflared_conf() }}
