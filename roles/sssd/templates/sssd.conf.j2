{%- import 'provider.ad.j2' as sssd_provider_ad with context -%}
{%- import 'provider.mixed.j2' as sssd_provider_mixed with context -%}
{%- import 'provider.ldap.j2' as sssd_provider_ldap with context -%}

{%- macro sssd_conf() -%}
{#
    SSSD Subsystem Configuration Layout Engine.
    Dynamically builds an adaptive authentication and identity model based on active role switches,
    allowing operators to toggle seamlessly between Kerberos and direct LDAP directory backends.

    Args:
        None

    Returns:
        str: A fully formatted, valid flat sssd.conf target deployment file.
#}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

[sssd]
config_file_version = 2
domains = {{ sssd_domain_name | trim }}
debug_level = {{ sssd_debug_level }}

{# Native services routing builder #}
{% if sssd_responder_activation_method == 'service' %}
{% set active_services = [] %}
{% if sssd_enable_nss | default(true) | bool %}{% set _ = active_services.append('nss') %}{% endif %}
{% if sssd_enable_pam | default(true) | bool %}{% set _ = active_services.append('pam') %}{% endif %}
{% if sssd_enable_autofs | default(true) | bool %}{% set _ = active_services.append('autofs') %}{% endif %}
{% if sssd_enable_ssh | default(true) | bool %}{% set _ = active_services.append('ssh') %}{% endif %}
{% if sssd_enable_sudo | default(true) | bool %}{% set _ = active_services.append('sudo') %}{% endif %}
{% if sssd_enable_pac | default(false) | bool %}{% set _ = active_services.append('pac') %}{% endif %}
{% if sssd_enable_ifp | default(true) | bool %}{% set _ = active_services.append('ifp') %}{% endif %}
services = {{ active_services | join(',') }}
{% else %}
{% set active_services = [] %}
{% if sssd_enable_ifp | default(true) | bool %}{% set _ = active_services.append('ifp') %}{% endif %}
services = {{ active_services | join(',') }}
{% endif %}
[domain/{{ sssd_domain_name | trim }}]
subdomains_provider = none
timeout = {{ sssd_timeout }}

{# --- IDENTITY & AUTHENTICATION BACKEND ENGINE SWITCHER --- #}
{# --- DYNAMIC MUTUALLY EXCLUSIVE PROVIDER INJECTIONS --- #}
{% if sssd_id_provider == 'ad' %}
    {{- sssd_provider_ad.create() }}
{% elif sssd_id_provider == 'ldap' and sssd_auth_provider == 'krb5' %}
    {{- sssd_provider_mixed.create() }}
{% elif sssd_id_provider == 'ldap' and sssd_auth_provider == 'ldap' %}
    {{- sssd_provider_ldap.create() }}
{% endif %}

# --- SYSTEM SERVICES BLOCKS ---
{% if sssd_enable_nss | bool %}
[nss]
homedir_substring = {{ sssd_nss_homedir_substring | trim }}
{% endif %}

{% if sssd_enable_pam | bool %}
[pam]
debug_level = {{ sssd_pam_debug_level }}
{% endif %}

{% if sssd_enable_sudo | bool %}
[sudo]
debug_level = {{ sssd_sudo_debug_level }}
{% endif %}

{% if sssd_enable_autofs | bool %}
[autofs]
debug_level = {{ sssd_autofs_debug_level }}
{% endif %}

{% if sssd_enable_ssh | bool %}
[ssh]
debug_level = {{ sssd_ssh_debug_level }}
{% endif %}

{% if sssd_enable_kdc | bool %}
[kcm]
debug_level = {{ sssd_kdc_debug_level | default('7') }}
ccache_storage = memory
{% endif %}

{% if sssd_enable_pac | bool %}
[pac]
debug_level = {{ sssd_pac_debug_level | default('7') }}
allowed_uids = root, sssd
{% endif %}

{% if sssd_enable_ifp | bool %}
[ifp]
debug_level = {{ sssd_ifp_debug_level | default('7') }}
allowed_uids = root{% if 'cockpit-ws' in ansible_facts.packages %}, cockpit-ws{% endif +%}
user_attributes = +mail, +telephoneNumber, +title
[session_recording]
{% endif %}
{%- endmacro -%}

{{- sssd_conf() }}
