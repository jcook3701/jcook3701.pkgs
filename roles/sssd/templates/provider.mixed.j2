{% import 'provider.ldap_common.j2' as ldap_common_provider with context %}

{%- macro create() -%}
{#
    Generates the identity and authentication parameters for the mixed backend track.
    Integrates an external OpenLDAP directory for user tracking alongside an Active
    Directory Kerberos realm for secure validation.

    Args:
        None

    Returns:
        str: A formatted block of standard LDAP identity and Kerberos authentication
        options.
#}
# --- DISCRETE BACKEND TRACK: LDAP IDENTITY WITH KERBEROS AUTH ---
id_provider = {{ sssd_id_provider | trim }}
ldap_schema = {{ sssd_ldap_schema | trim }}
ldap_rfc2307_fallback_to_local_users = {{ sssd_ldap_rfc2307_fallback_to_local_users | trim }}

# Explicitly bind the structural identity mapping attributes
ldap_group_object_class = {{ sssd_ldap_group_object_class | trim }}
ldap_group_name = {{ sssd_ldap_group_name | trim }}
ldap_group_gid_number = {{ sssd_ldap_group_gid_number | trim }}
ldap_group_member = {{ sssd_ldap_group_member | trim }}
ldap_group_uuid = {{ sssd_ldap_group_uuid | trim }}
ldap_user_uuid = {{ sssd_ldap_user_uuid | trim }}

ldap_id_mapping = {{ sssd_ldap_id_mapping | lower | trim }}
ldap_tls_reqcert = {{ sssd_ldap_tls_reqcert | trim }}
ldap_uri = {{ sssd_ldap_uri | trim }}
ldap_sasl_minssf = 0
ldap_search_base = {{ sssd_ldap_search_base | trim }}
ldap_user_search_base = {{ sssd_ldap_user_search_base | trim }}
ldap_group_search_base = {{ sssd_ldap_group_search_base | trim }}
ldap_access_filter = {{ sssd_ldap_access_filter | trim }}

# Identity Provider SASL Hooks
ldap_sasl_mech = {{ sssd_ldap_sasl_mech | trim }}
ldap_user_principal = {{ sssd_ldap_user_principal | trim }}

# Authentication Provider Settings
auth_provider = {{ sssd_auth_provider | trim }}
chpass_provider = {{ sssd_chpass_provider | trim }}
krb5_server = {{ sssd_krb5_server | trim }}
krb5_realm = {{ sssd_krb5_realm | upper | trim }}
krb5_validate = {{ sssd_krb5_validate | string | lower }}
cache_credentials = {{ sssd_cache_credentials | string | lower }}
krb5_store_password_if_offline = {{ sssd_krb5_store_password_if_offline | string | lower }}
ldap_sasl_authid = host/{{ ansible_fqdn }}@{{ sssd_krb5_realm | upper | trim }}
ldap_krb5_keytab = {{ sssd_file.keytab | trim }}
krb5_ccname_template = FILE:%d/krb5cc_%U

{{- ldap_common_provider.create() }}
{%- endmacro -%}
